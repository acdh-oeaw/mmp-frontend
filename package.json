{
	"name": "@acdh-oeaw/mmp-frontend",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"analyze": "nuxt analyze",
		"build": "nuxt build --dotenv ./.env.local",
		"dev": "nuxt dev --dotenv ./.env.local",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "stylelint \"./**/*.@(css|vue)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"postinstall": "nuxt prepare",
		"prepare": "run-s setup",
		"setup": "is-in-ci || lefthook install",
		"start": "nuxt preview --dotenv ./.env.local",
		"test": "exit 0",
		"test:e2e": "playwright test",
		"types:check": "nuxt typecheck",
		"validate": "run-s format:check lint:check types:check test"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.1.12",
		"@fontsource-variable/roboto-flex": "^5.3.0",
		"@headlessui/vue": "^1.7.23",
		"@heroicons/vue": "^2.2.0",
		"@mdx-js/mdx": "^3.1.1",
		"@stefanprobst/request": "^0.2.1",
		"@zag-js/slider": "^1.49.0",
		"@zag-js/vue": "^1.49.0",
		"d3": "^7.9.2",
		"estree-util-value-to-estree": "^3.5.0",
		"fast-glob": "^3.3.3",
		"force-graph": "^1.52.0",
		"graphology": "^0.26.0",
		"graphology-gexf": "^0.13.2",
		"highcharts": "^10.3.3",
		"leaflet": "^1.9.4",
		"nuxt": "^4.7.0",
		"unist-util-visit": "^5.2.0",
		"valibot": "^1.5.0",
		"vue": "^3.5.46",
		"vue-jsx-runtime": "^0.1.0",
		"vue-router": "^5.5.3"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@headlessui/tailwindcss": "^0.2.2",
		"@nuxt/image": "^2.2.1",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/vue-query": "^5.108.4",
		"@types/d3": "^7.4.3",
		"@types/geojson": "^7946.0.16",
		"@types/leaflet": "^1.9.23",
		"@types/node": "^26.0.0",
		"graphology-types": "^0.24.8",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.4",
		"npm-run-all2": "^9.1.0",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"stylelint": "^18.1.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.14"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.24.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "error"
		}
	}
}
